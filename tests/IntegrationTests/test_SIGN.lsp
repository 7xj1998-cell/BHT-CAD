(signs-check "delineator-tail-at-picked-point" (and post (= (cdr (assoc 2 (entget post))) "BHT_KH_COC_TIEU") (equal (cdr (assoc 10 (entget post))) '(20.0 30.0 0.0) 1e-6)))
(setq s (cdr (assoc 41 (entget post))) expected-head-label (polar (polar '(20.0 30.0 0.0) 0.7 (* -0.78 s)) (+ 0.7 (/ pi 2)) (* -0.3944 s)))
(signs-check "delineator-label-below-symbol-and-rotates" (and post-label (equal (cdr (assoc 11 (entget post-label))) expected-head-label 1e-6) (equal (cdr (assoc 50 (entget post-label))) 0.7 1e-6)))
