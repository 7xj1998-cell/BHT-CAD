(signs-check "global-fill-API-on" (= (car (bht:api-sign-fill "1")) "OK"))
(bht:kh-free-apply "OBJ-SIGN" '(65.0 -25.0 0.0) 2.4 '((60.0 -18.0 0.0)))
(setq compact-label (cdr (assoc "OBJ-SIGN" (bht:tagged-pairs "TEXT" "BHT_KH" 1))) label-data (entget compact-label)
