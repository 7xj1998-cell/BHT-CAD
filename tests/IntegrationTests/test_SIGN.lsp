(signs-check "post-stays-at-survey" (equal (car result) '(50.0 -5.0 0.0) 1e-8))
(signs-check "post-rotates" (equal (abs (sin (cadr result))) 1.0 1e-8))
(setq rec (bht:set rec "route_id" ""))
(signs-check "no-route-zero" (equal (cadr (bht:kh-auto-transform rec '(50.0 -5.0 0.0) 1.0)) 0.0 1e-8))
