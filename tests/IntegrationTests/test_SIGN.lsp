(vl-load-com)
(setq *sign-test-fail* 0)
(defun signs-check (name ok) (if (not ok) (setq *sign-test-fail* (1+ *sign-test-fail*))) (princ (strcat "\n" (if ok "PASS " "FAIL ") "SIGN " name)))
(signs-check "chunks-reject-invalid-size" (and (null (bht:chunks "abc" 0)) (null (bht:chunks "abc" -1)) (equal (bht:chunks "abc" 2) (quote ("ab" "c")))))
(signs-check "removed-command-aliases" (not (vl-some 'bht:fn-defined-p '(c:BHTIMPORT c:BHTCSV c:BHTNK c:BHTLABEL c:BHTTAG c:BHTEDIT c:BHTDELETE c:BHTUNTAG c:BHTDSANH c:BHTSYNCANH c:BHTPHOTO c:BHTEXPORT c:BHTSUMMARY c:BHTCHECK))))
(signs-check "invalid-speed-validation" (/= (BHTSIGNVALIDATE "P.127-800") ""))
(signs-check "native-family-rejects-extra-suffix" (and (bht:bb-family-p "W207A" "W207") (not (bht:bb-family-p "W207ZZ" "W207"))))
(signs-check "invalid-cached-vector-not-reused" (= (bht:bb-block-for "W.207zz") "BHT_KH_BIEN_BAO_V044"))
(setq pl (entmakex '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (8 . "0") (100 . "AcDbPolyline") (90 . 2) (70 . 0) (10 0.0 0.0) (10 100.0 0.0))))
(bht:route-create "SIGNROUTE" pl "TIM_DUONG" 20.0 0.0 nil "test")
(bht:route-set-start-dir "SIGNROUTE" '(0.0 0.0 0.0) 1)
(setq rec (list (cons "nhom" "BIEN_BAO") (cons "route_id" "SIGNROUTE") (cons "phia_tuyen" "PHAI")))
