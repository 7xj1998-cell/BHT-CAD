(signs-check "right-forward-90" (equal (cadr result) (/ pi 2.0) 1e-8))
(setq rec (bht:set rec "phia_tuyen" "TRAI"))
(signs-check "left-forward-minus90" (equal (cadr (bht:kh-auto-transform rec '(50.0 5.0 0.0) 1.0)) (- (/ pi 2.0)) 1e-8))
