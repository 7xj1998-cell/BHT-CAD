(signs-check "description-import-80" (= (bht:kh-block rec) sign-expected-speed80))
(signs-check "nonuniform-global-custom-factor-ignored" (progn (bht:meta-set "kh_block_bien_bao" "SIGN_CUSTOM_TEST") (bht:meta-set "kh_block_factor_bien_bao" "3") (setq rec (bht:set rec "custom_block" "SIGN_CUSTOM_TEST")) (equal (bht:kh-scale-for rec) (bht:kh-scale) 1e-8)))
(bht:meta-set "kh_block_bien_bao" "")
(bht:meta-set "kh_block_factor_bien_bao" "1")
