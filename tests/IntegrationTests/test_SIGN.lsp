(setq rec (bht:set rec "custom_block" "SIGN_CUSTOM_TEST"))
(signs-check "object-custom-priority" (= (bht:kh-block rec) "SIGN_CUSTOM_TEST"))
(setq rec (list (cons "nhom" "BIEN_BAO") (cons "ma_hieu" "P.127") (cons "mo_ta" "gioihan80")))
