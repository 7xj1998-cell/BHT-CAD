(if multi-insert
 (progn
  (setq multi-name (cdr (assoc 2 (entget multi-insert))) multi-entity (tblobjname "BLOCK" multi-name))
  (while (and (setq multi-entity (entnext multi-entity)) (/= (cdr (assoc 0 (entget multi-entity))) "ENDBLK"))
   (if (= (cdr (assoc 0 (entget multi-entity))) "INSERT") (setq plate-count (1+ plate-count))))))
(signs-check "api-one-post-two-visible-plates" (and multi-insert (= plate-count 2)))
(setq multi-before (entget multi-insert))
(bht:api-symbol-sync "OBJ-MULTI")
(signs-check "api-two-plates-update-idempotent" (equal multi-before (entget multi-insert)))
