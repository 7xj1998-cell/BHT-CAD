(signs-check "global-fill-all-existing-signs" (and (wcmatch (cdr (assoc 2 (entget (cdr (assoc "OBJ-SIGN" fill-pairs))))) "*_NOFILL_V062") (wcmatch (cdr (assoc 2 (entget (cdr (assoc "OBJ-SECOND" fill-pairs))))) "*_NOFILL_V062")))
(signs-check "global-fill-does-not-insert-unseen" (null (assoc "OBJ-UNSEEN" fill-pairs)))
