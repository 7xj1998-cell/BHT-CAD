(if (= (getenv "BHT_SIGN_PROVIDER") "BUILTIN")
 (foreach code '("S.501@350" "S.502@150" "S.509a@4.5" "P.119@8")
  (setq block-m (bht:bb-block-for code) e-m (tblobjname "BLOCK" block-m) found-m nil)
  (while (and (setq e-m (entnext e-m)) (/= (cdr (assoc 0 (entget e-m))) "ENDBLK"))
   (if (and (= (cdr (assoc 0 (entget e-m))) "TEXT") (= (cdr (assoc 1 (entget e-m))) (BHTMETRETEXT code "10 m"))) (setq found-m T)))
  (signs-check (strcat "offline-metres-" code) found-m)))
