(bht:meta-set "sign_fill_all" "1")
(signs-check "symbol-layer-white" (= (cdr (assoc 62 (tblsearch "LAYER" "BHT_KYHIEU"))) 7))
(signs-check "compact-default-label-height" (equal (bht:kh-h) 0.35 1e-6))
(signs-check "custom-label-height" (equal (bht:kh-label-height '(("kh_label_h" . "0.25"))) (* 0.36 (bht:kh-scale)) 1e-6))
(signs-check "quick-invalid-mode-error" (= (car (bht:api-sign-place "OBJ-SIGN" "BAD" "HORIZONTAL" "0")) "LOI"))
(princ (strcat "\nSIGN-TEST-FAIL=" (itoa *sign-test-fail*)))

(bht:obj-write "OBJ-SIGN" (bht:set (bht:obj-read "OBJ-SIGN") "kh_label_h" "0.25"))
(bht:symbol-sync '("OBJ-SIGN"))
(setq compact-label (cadr (assoc "OBJ-SIGN" (bht:group-pairs (bht:tagged-pairs "TEXT" "BHT_KH" 1)))))
(signs-check "label-height-on-CAD-entity" (and compact-label (and (= (cdr (assoc 72 (entget compact-label))) 1) (= (cdr (assoc 73 (entget compact-label))) 3))))
(princ (strcat "\nSIGN-TEST-FAIL=" (itoa *sign-test-fail*)))

(setq unrelated (entmakex '((0 . "SOLID") (8 . "0") (10 0.0 0.0 0.0) (11 1.0 0.0 0.0) (12 0.0 1.0 0.0) (13 1.0 1.0 0.0))) unrelated-before (entget unrelated))
