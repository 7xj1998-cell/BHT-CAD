  (setq board-before (entget board-ins))
  (bht:symbol-sync (list board-id))
  (signs-check (strcat "board-idempotent-" board-group) (equal board-before (entget board-ins)))
  (bht:obj-write board-id (bht:set board-rec "mo_ta" "Tên mới"))
  (bht:symbol-sync (list board-id))
  (signs-check (strcat "board-edit-keeps-position-" board-group)
    (and (equal (cdr (assoc 10 (entget board-ins))) '(32.0 12.0 0.0) 1e-6)
         (equal (cdr (assoc 50 (entget board-ins))) 0.35 1e-6)
         (if (= board-group "CHUA_XAC_DINH") (= board-name (cdr (assoc 2 (entget board-ins))))
           (/= board-name (cdr (assoc 2 (entget board-ins)))))))
  (bht:obj-write board-id (bht:set board-rec "custom_block" "SIGN_CUSTOM_TEST"))
  (signs-check (strcat "board-custom-block-priority-" board-group) (= (bht:kh-block (bht:obj-read board-id)) "SIGN_CUSTOM_TEST")))

(if (= (getenv "BHT_SIGN_PROVIDER") "BUILTIN")
  (progn
