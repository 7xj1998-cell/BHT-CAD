(princ (strcat "\nSIGN-TEST-FAIL=" (itoa *sign-test-fail*)))

(setq unrelated (entmakex '((0 . "SOLID") (8 . "0") (10 0.0 0.0 0.0) (11 1.0 0.0 0.0) (12 0.0 1.0 0.0) (13 1.0 1.0 0.0))) unrelated-before (entget unrelated))
