(setq rec (bht:set (bht:set (bht:set rec "custom_block" "") "route_id" "SIGNROUTE") "phia_tuyen" "TRAI"))
(bht:obj-write "OBJ-SIGN" rec)
(setq sync1 (bht:symbol-sync '("OBJ-SIGN")))
(setq sym (cadr (assoc "OBJ-SIGN" (bht:group-pairs (bht:tagged-pairs "INSERT" "BHT_KH" 1)))))
(signs-check "sync-creates-speed80" (and sym (= (cdr (assoc 2 (entget sym))) sign-expected-speed80)))
(setq before (entget sym) sync2 (bht:symbol-sync '("OBJ-SIGN")))
(signs-check "repeat-sync-idempotent" (and (= (cdr (assoc 'created sync2)) 0) (equal before (entget sym))))
(entmod (bht:dxf-put (entget sym) 50 0.321))
(bht:symbol-sync '("OBJ-SIGN"))
(signs-check "manual-rotation-preserved" (equal (cdr (assoc 50 (entget sym))) 0.321 1e-8))
;; Free placement persists independently from route, and leads via picked corners.
(setq source-record (bht:obj-read "OBJ-SIGN") source-point (entget survey))
(bht:kh-free-apply "OBJ-SIGN" '(65.0 -25.0 0.0) 0.75 '((55.0 -8.0 0.0) (60.0 -18.0 0.0)))
(setq free-record (bht:obj-read "OBJ-SIGN") free-leader (cadr (assoc "OBJ-SIGN" (bht:group-pairs (bht:tagged-pairs "LWPOLYLINE" "BHT_KH" 1)))))
(signs-check "free-position-angle" (and (equal (cdr (assoc 10 (entget sym))) '(65.0 -25.0 0.0) 1e-8) (equal (cdr (assoc 50 (entget sym))) 0.75 1e-8)))
(signs-check "free-route-and-RTK-kept" (and (= (bht:get source-record "route_id") (bht:get free-record "route_id")) (equal source-point (entget survey))))
(signs-check "free-polyline-four-vertices" (and free-leader (= (cdr (assoc 90 (entget free-leader))) 4)
  (equal (mapcar 'cdr (vl-remove-if-not '(lambda (pair) (= (car pair) 10)) (entget free-leader))) '((50.0 -5.0) (55.0 -8.0) (60.0 -18.0) (65.0 -25.0)) 1e-8)))
(setq free-before (entget free-leader) ins-before (entget sym))
(bht:symbol-sync '("OBJ-SIGN"))
(signs-check "free-repeat-idempotent" (and (equal free-before (entget free-leader)) (equal ins-before (entget sym))))
(entmod (bht:dxf-put (entget sym) 10 '(70.0 -30.0 0.0)))
(bht:symbol-sync '("OBJ-SIGN"))
(signs-check "free-move-updates-end-keeps-corners" (equal (mapcar 'cdr (vl-remove-if-not '(lambda (pair) (= (car pair) 10)) (entget free-leader))) '((50.0 -5.0) (55.0 -8.0) (60.0 -18.0) (70.0 -30.0)) 1e-8))
(bht:kh-free-apply "OBJ-SIGN" '(80.0 -20.0 0.0) 1.25 nil)
(signs-check "free-replace-route-straight" (and (= (length (bht:tagged-pairs "LWPOLYLINE" "BHT_KH" 1)) 0) (= (length (vl-remove-if-not '(lambda (pair) (= (car pair) "OBJ-SIGN")) (bht:tagged-pairs "LINE" "BHT_KH" 1))) 1)
  (equal (cdr (assoc 10 (entget sym))) '(80.0 -20.0 0.0) 1e-8)))
(bht:kh-free-apply "OBJ-SIGN" '(65.0 -25.0 0.0) 0.75 '((60.0 -18.0 0.0)))
(bht:symbol-reset '("OBJ-SIGN"))
(signs-check "free-reset-to-route" (and (= (bht:get (bht:obj-read "OBJ-SIGN") "kh_mode") "")
 (= (length (bht:tagged-pairs "LWPOLYLINE" "BHT_KH" 1)) 0)
 (equal (cdr (assoc 10 (entget sym))) (car (bht:kh-route-transform (bht:obj-read "OBJ-SIGN") '(50.0 -5.0 0.0) (bht:kh-scale))) 1e-8)))
(setq before-missing-ids (bht:obj-ids) before-missing-sym (entget sym))
(signs-check "missing-free-object-returns-error" (eq (car (bht:kh-place-free "__MISSING__")) 'LOI))
(signs-check "missing-free-object-API-error" (= (car (bht:api-sign-free "__MISSING__")) "LOI"))
(signs-check "empty-free-object-returns-error" (eq (car (bht:kh-place-free nil)) 'LOI))
(signs-check "missing-object-does-not-write" (and (equal before-missing-ids (bht:obj-ids)) (equal before-missing-sym (entget sym))))
(bht:kh-free-apply "OBJ-SIGN" '(65.0 -25.0 0.0) 0.75 '((55.0 -8.0 0.0) (60.0 -18.0 0.0)))
(setq leader-order (cadr (assoc "OBJ-SIGN" (bht:group-pairs (bht:tagged-pairs "LWPOLYLINE" "BHT_KH" 1)))))
(bht:kh-free-apply "OBJ-SIGN" '(65.0 -25.0 0.0) 0.75 '((60.0 -18.0 0.0) (55.0 -8.0 0.0)))
(signs-check "changed-waypoint-order-kept" (equal (bht:kh-leader-xy (bht:kh-via-points (bht:obj-read "OBJ-SIGN"))) '((60.0 -18.0) (55.0 -8.0))))
(signs-check "changed-waypoint-order-on-entity" (equal (mapcar 'cdr (vl-remove-if-not '(lambda (pair) (= (car pair) 10)) (entget leader-order))) '((50.0 -5.0) (60.0 -18.0) (55.0 -8.0) (65.0 -25.0)) 1e-8))
(setq leader-before (entget leader-order))
(bht:symbol-sync '("OBJ-SIGN"))
(signs-check "reordered-leader-repeat-idempotent" (equal leader-before (entget leader-order)))
(bht:obj-write "OBJ-NOPOINT" '(("nhom" . "BIEN_BAO")))
(signs-check "free-no-RTK-returns-error" (eq (car (bht:kh-place-free "OBJ-NOPOINT")) 'LOI))
(bht:obj-delete "OBJ-NOPOINT")
(bht:symbol-reset '("OBJ-SIGN"))
(princ (strcat "\nSIGN-TEST-FAIL=" (itoa *sign-test-fail*)))
(princ)
(foreach board-group '("BANG_QC" "KHAC" "CHUA_XAC_DINH")
  (setq board-id (strcat "OBJ-BOARD-" board-group)
        board-fields (list (cons "nhom" board-group) (cons "mo_ta" "Cửa hàng vật liệu")))
  (bht:obj-create board-id board-fields '("SIGN-PT") T)
  (bht:kh-free-apply board-id '(32.0 12.0 0.0) 0.35 nil)
  (setq board-rec (bht:obj-read board-id)
        board-ins (cdr (assoc board-id (bht:tagged-pairs "INSERT" "BHT_KH" 1)))
        board-name (cdr (assoc 2 (entget board-ins))))
  (signs-check (strcat "named-board-" board-group)
    (and (wcmatch board-name "BHT_BOARD_V0625_*") (= (bht:kh-label board-id board-rec) "")
         (null (assoc board-id (bht:tagged-pairs "TEXT" "BHT_KH" 1)))))
  (if (= board-group "CHUA_XAC_DINH")
