(signs-check "label-bottom-center-alignment" (and (= (cdr (assoc 72 label-data)) 1) (= (cdr (assoc 73 label-data)) 3) (equal (cdr (assoc 11 label-data)) (car wanted-layout) 1e-6)))
(signs-check "label-height-follows-sign" (equal (cdr (assoc 40 label-data)) (cadr wanted-layout) 1e-6))
(bht:obj-delete "OBJ-SECOND") (bht:obj-delete "OBJ-UNSEEN")
(princ (strcat "\nSIGN-TEST-FAIL=" (itoa *sign-test-fail*)))
(signs-check "no-legacy-upgrade-commands" (and (not (bht:fn-defined-p 'c:BHTNANGCAP)) (not (bht:fn-defined-p 'c:BHTVEMODEL)) (not (bht:fn-defined-p 'c:BHTROUTE))))
(signs-check "metre-label-readable" (= (bht:kh-code-label "BIEN_BAO" "S.509a@4.5") "S.509a (4.5 m)"))
(bht:obj-create "OBJ-POST" '(("nhom" . "COC_TIEU")) '("SIGN-PT") T)
(bht:kh-free-apply "OBJ-POST" '(20.0 30.0 0.0) 0.7 nil)
(setq post (cdr (assoc "OBJ-POST" (bht:tagged-pairs "INSERT" "BHT_KH" 1))) post-label (cdr (assoc "OBJ-POST" (bht:tagged-pairs "TEXT" "BHT_KH" 1))))
(signs-check "delineator-tail-at-picked-point" (and post (= (cdr (assoc 2 (entget post))) "BHT_KH_COC_TIEU") (equal (cdr (assoc 10 (entget post))) '(20.0 30.0 0.0) 1e-6)))
(setq s (cdr (assoc 41 (entget post))) expected-head-label (polar (polar '(20.0 30.0 0.0) 0.7 (* -1.67 s)) (+ 0.7 (/ pi 2)) (* 0.75 s)))
(signs-check "delineator-label-above-head-and-rotates" (and post-label (equal (cdr (assoc 11 (entget post-label))) expected-head-label 1e-6) (equal (cdr (assoc 50 (entget post-label))) 0.7 1e-6)))
(setq before-post (entget post) before-post-label (entget post-label))
(bht:symbol-sync '("OBJ-POST"))
(signs-check "delineator-sync-idempotent" (and (equal before-post (entget post)) (equal before-post-label (entget post-label))))
(bht:obj-create "OBJ-OTHER" '(("nhom" . "CONG_TRINH")) '("SIGN-PT") T)
(bht:kh-free-apply "OBJ-OTHER" '(25.0 30.0 0.0) 1.2 '((15.0 20.0 0.0)))
(setq other (cdr (assoc "OBJ-OTHER" (bht:tagged-pairs "INSERT" "BHT_KH" 1))))
(signs-check "other-group-free-placement-and-direction" (and other (equal (cdr (assoc 10 (entget other))) '(25.0 30.0 0.0) 1e-6) (equal (cdr (assoc 50 (entget other))) 1.2 1e-6)))
(signs-check "assembly-function-registered-for-lisp" (bht:fn-defined-p 'BHTSIGNASSEMBLY))
(bht:obj-create "OBJ-MULTI" '(("nhom" . "BIEN_BAO") ("ma_hieu" . "W.239") ("so_tru" . "1") ("so_mat" . "2") ("mat" . "W.239") ("mat" . "S.509a@7")) '("SIGN-PT") T)
