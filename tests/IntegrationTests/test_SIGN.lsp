(setq result (bht:kh-auto-transform rec '(50.0 -5.0 0.0) 1.0))
(signs-check "reverse-left" (equal (sin (cadr result)) 1.0 1e-8))
(setq rec (bht:set rec "nhom" "COC_TIEU"))
