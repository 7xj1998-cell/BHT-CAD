(setvar "FILEDIA" 0)
(setvar "LISPSYS" 1)
(setvar "BACKGROUNDPLOT" 0)
(vl-cmdf "_.NETLOAD" "@STAGE@/@BIN@/BHT.Bridge.dll")
(vl-cmdf "_.NETLOAD" "@STAGE@/@BIN@/Sign0611Probe.dll")
(setq *bht-module-root* "@STAGE@")
(load "@STAGE@/BHT-0.6.11.lsp")
(bht:symbol-blocks)
