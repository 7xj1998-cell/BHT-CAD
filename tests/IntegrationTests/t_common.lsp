;; so trang thai nhan
(defun t-lbl-states (/ a t2 l s)
  (setq a 0 t2 0 l 0)
  (foreach p (bht:tagged-pairs "TEXT" "BHT_NHAN" 2)
    (setq s (bht:lbl-state (cdr p)))
    (cond ((eq s 'AUTO) (setq a (1+ a))) ((eq s 'TAY) (setq t2 (1+ t2))) (T (setq l (1+ l)))))
  (list a t2 l))
;; dat nhan cua cac diem ve vi tri mac dinh 0.3.2 (de do chong lan "truoc")
(defun t-lbl-to-legacy (pids / st h off idx g ex kinds p pos n)
  (setq st (bht:lbl-settings) h (cdr (assoc 'h st)) off (cdr (assoc 'off st)) idx (bht:pt-all)
        g (bht:group-pairs (bht:tagged-pairs "TEXT" "BHT_NHAN" 2)) n 0)
  (foreach pid (mapcar 'strcase pids)
    (setq p (bht:pt-find pid idx) kinds nil)
    (foreach kd *bht-lbl-kinds* (if (assoc (strcat pid "|" (car kd)) g) (setq kinds (cons (car kd) kinds))))
    (foreach k kinds
      (setq ex (cadr (assoc (strcat pid "|" k) g)) pos (bht:lbl-legacy-pos p k kinds h off))
      (setq d (entget ex))
      (entmod (subst (list 10 (car pos) (cadr pos) (cadddr (assoc 10 d))) (assoc 10 d) d)) (entupd ex) (setq n (1+ n))))
  n)
;; bang SORTENTS cua Model: ((ename . handle_sap) ...)
(defun t-hex (s / v c)
  (setq v 0.0)
  (foreach c (vl-string->list (strcase s))
    (setq v (+ (* v 16.0) (if (<= c 57) (- c 48) (- c 55)))))
  v)
(defun t-sortents (/ br xd sd out cur)
  (setq br (cdr (assoc 330 (entget (tblobjname "BLOCK" "*Model_Space")))) out nil)
  (setq xd (cdr (assoc 360 (member '(102 . "{ACAD_XDICTIONARY") (entget br)))))
  (if (and xd (setq sd (dictsearch xd "ACAD_SORTENTS")))
    (foreach g sd
      (cond ((= (car g) 331) (setq cur (cdr g)))
            ((and (= (car g) 5) cur) (setq out (cons (cons cur (cdr g)) out) cur nil)))))
  out)
(defun t-rank (e se / h) (setq h (cdr (assoc e se))) (t-hex (if h h (cdr (assoc 5 (entget e))))))
(defun t-rank-range (ents se / lo hi r)
  (foreach e ents (setq r (t-rank e se) lo (if lo (min lo r) r) hi (if hi (max hi r) r)))
  (list lo hi))
(defun t-write-state (name alist / sf)
  (setq sf (open (strcat *T-DIR* "run/state_" name ".txt") "w" "utf8"))
  (foreach it alist
    (if (= (car it) "lblpos")
      (foreach pp (cdr it) (write-line (strcat "lbl:" (car pp) "=" (t-ser (cdr pp))) sf))
      (write-line (strcat (car it) "=" (t-ser (cdr it))) sf)))
  (close sf))
(defun t-read-state (name / f l out p lp)
  (setq out nil lp nil)
  (if (setq f (open (strcat *T-DIR* "run/state_" name ".txt") "r" "utf8"))
    (progn (while (setq l (read-line f))
             (setq p (vl-string-search "=" l))
             (if (= (substr l 1 4) "lbl:")
               (setq lp (cons (cons (substr l 5 (- p 4)) (read (substr l (+ p 2)))) lp))
               (setq out (cons (cons (substr l 1 p) (read (substr l (+ p 2)))) out))))
           (close f)))
  (cons (cons "lblpos" lp) out))
(defun t-mk (pid) (cdr (assoc (strcase pid) (bht:group-pairs (bht:tagged-pairs "INSERT" "BHT_ANHPT" 1)))))
;; so diem trong ref bi doi toa do / mat
(defun t-pts-diff (ref / cur n c)
  (setq cur (t-pt-coords) n 0)
  (foreach it ref (setq c (assoc (car it) cur)) (if (not (and c (equal (cdr c) (cdr it) 1e-12))) (setq n (1+ n))))
  n)
(defun t-ser (v / out)
  (cond ((null v) "nil")
        ((= (type v) 'REAL) (rtos v 2 10))
        ((= (type v) 'INT) (itoa v))
        ((= (type v) 'STR) (vl-prin1-to-string v))
        ((= (type v) 'SYM) (vl-symbol-name v))
        ((and (listp v) (cdr v) (atom (cdr v))) (strcat "(" (t-ser (car v)) " . " (t-ser (cdr v)) ")"))
        ((listp v) (setq out "(") (foreach x v (setq out (strcat out (t-ser x) " "))) (strcat out ")"))
        (T (vl-prin1-to-string v))))
