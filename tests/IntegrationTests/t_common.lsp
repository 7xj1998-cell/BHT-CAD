(setq *T-DIR* "C:/Users/Le Bao/BHT_TEST_V044/")
(setq *T-LSP* (strcat *T-DIR* "thư mục có dấu/BHT-0.6.54.lsp"))
(setq *T-PASS* 0 *T-FAIL* 0 *T-SKIP* 0)
(defun tlog (s) (write-line s *T-OUT*) (princ (strcat "\n" s)))
(defun tchk (id name ok detail)
  (if ok (setq *T-PASS* (1+ *T-PASS*)) (setq *T-FAIL* (1+ *T-FAIL*)))
  (tlog (strcat (if ok "PASS " "FAIL ") id " " name (if detail (strcat " | " (vl-princ-to-string detail)) ""))))
(defun tskip (id name status reason)
  (setq *T-SKIP* (1+ *T-SKIP*))
  (tlog (strcat status " " id " " name " | " reason)))
(defun tsafe (id name fn / r)
  (setq r (vl-catch-all-apply fn nil))
  (if (vl-catch-all-error-p r)
    (progn (tchk id name nil (strcat "LỖI: " (vl-catch-all-error-message r))) nil)
    r))
(defun rv (res k) (cdr (assoc k res)))
(defun tbegin (name)
  (setq *T-OUT* (open (strcat *T-DIR* "run/result_" name ".txt") "w" "utf8"))
  (tlog (strcat "Phiên " name ": " (getvar "DWGNAME") " | ACADVER=" (getvar "ACADVER") " | LISPSYS="
                (itoa (getvar "LISPSYS")) " | CDATE=" (rtos (getvar "CDATE") 2 6))))
(defun tend (name)
  (tlog (strcat "TONG PHIEN " name ": " (itoa *T-PASS*) " PASS, " (itoa *T-FAIL*) " FAIL, " (itoa *T-SKIP*) " SKIP/BLOCKED"))
  (close *T-OUT*))
(defun tload (/ r)
  (setq r (vl-catch-all-apply 'load (list *T-LSP*)))
  (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) nil))
;; dem thuc the theo loc
(defun tcount (flt / ss) (setq ss (ssget "_X" flt)) (if ss (sslength ss) 0))
;; --- bo sung 0.3.3 ---
(defun t-bht-ent-p (e)
  (vl-some '(lambda (a) (bht:xget e a)) '("BHT_PT" "BHT_RTK" "BHT_NHAN" "BHT_ANHPT" "BHT_ANHTEN" "BHT_ANHRS" "BHT_KH" "BHT_SIGN_ORIGIN" "BHT_ANHDAN")))
(defun t-snapshot (/ e out)
  (setq e (entnext) out nil)
  (while e (if (not (t-bht-ent-p e)) (setq out (cons (entget e) out))) (setq e (entnext e)))
  out)
(defun t-snap-diff (snap / changed missing e)
  (setq changed 0 missing 0)
  (foreach d snap
    (setq e (cdr (assoc -1 d)))
    (cond ((null (entget e)) (setq missing (1+ missing)))
          ((not (equal (entget e) d))
           (setq changed (1+ changed))
           (if (<= changed 3)
             (tlog (strcat "   thay đổi: " (cdr (assoc 0 d)) " " (cdr (assoc 5 d)) " layer " (cdr (assoc 8 d))
                           " | trước: " (vl-princ-to-string (vl-remove-if '(lambda (g) (member g (entget e))) d))
                           " | sau: " (vl-princ-to-string (vl-remove-if '(lambda (g) (member g d)) (entget e)))))))))
  (list (length snap) missing changed))
(defun t-lbl-count (kind / n)
  (setq n 0)
  (foreach p (bht:tagged-pairs "TEXT" "BHT_NHAN" 2) (if (wcmatch (car p) (strcat "*|" kind)) (setq n (1+ n))))
  n)
(defun t-lbl-dups (/ n)
  (setq n 0)
  (foreach g (bht:group-pairs (bht:tagged-pairs "TEXT" "BHT_NHAN" 2)) (if (> (length (cdr g)) 1) (setq n (1+ n))))
  n)
(defun t-lbl-ent (pid kind) (cadr (assoc (strcat (strcase pid) "|" kind) (bht:group-pairs (bht:tagged-pairs "TEXT" "BHT_NHAN" 2)))))
(defun t-lbl-pos (pid kind / e) (if (setq e (t-lbl-ent pid kind)) (cdr (assoc 10 (entget e)))))
(defun t-pt-ent (id) (bht:pv (bht:pt-find id (bht:pt-all)) 'ent))
(defun t-pt-coords (/ out)
  (setq out nil)
  (foreach it (bht:pt-all) (setq out (cons (cons (car it) (cdr (assoc 10 (entget (bht:pv (cdr it) 'ent))))) out)))
  out)
(defun t-mk-count () (length (bht:tagged-pairs "INSERT" "BHT_ANHPT" 1)))
(defun t-kh-ins () (bht:tagged-pairs "INSERT" "BHT_KH" 1))
(defun t-kh-ins-of (oid) (cdr (assoc oid (bht:group-pairs (t-kh-ins)))))
(defun t-move (e dx dy / d p)
  (setq d (entget e) p (cdr (assoc 10 d)))
  (entmod (subst (list 10 (+ (car p) dx) (+ (cadr p) dy) (caddr p)) (assoc 10 d) d)) (entupd e))
(defun t-lbl-str (pid kind / e) (if (setq e (t-lbl-ent pid kind)) (cdr (assoc 1 (entget e))) nil))
(defun t-verify-csv (path ds / recs idx bad p)
  (setq recs (car (bht:csv-records path ds)) idx (bht:pt-all) bad 0)
  (foreach rr recs
    (setq p (bht:pt-find (car rr) idx))
    (if (not (and p (= (bht:pv p 'name) (nth 3 rr)) (= (bht:pv p 'n) (nth 4 rr)) (= (bht:pv p 'e) (nth 5 rr))
                  (= (bht:pv p 'z) (nth 6 rr)) (= (bht:pv p 'desc) (nth 7 rr))
                  (equal (bht:pv p 'xyz) (list (atof (nth 5 rr)) (atof (nth 4 rr)) (atof (nth 6 rr))) 1e-9)))
      (setq bad (1+ bad))))
  (list (length recs) bad))
(defun t-verify-labels (path ds kinds / recs bad n s want)
  (setq recs (car (bht:csv-records path ds)) bad nil n 0)
  (foreach rr recs
    (foreach k kinds
      (setq want (cond ((= k "TEN") (nth 3 rr)) ((= k "MOTA") (nth 7 rr))
                       ((= k "CAODO") (strcat "H = " (nth 6 rr))) ((= k "ID") (car rr))))
      (setq s (t-lbl-str (car rr) k))
      (cond ((= want "") (if s (setq bad (cons (strcat (car rr) "|" k "=co nhan rong") bad))))
            ((/= s want) (setq bad (cons (strcat (car rr) "|" k) bad)))
            (T (setq n (1+ n))))))
  (list n bad))
