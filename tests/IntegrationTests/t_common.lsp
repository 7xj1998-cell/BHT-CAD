;; Dump chuan phia Lisp - CUNG dinh dang voi BHTNETDUMP (C#)
(defun t-dump (path / f p xyz)
  (setq f (open path "w" "utf8"))
  (write-line "#BHT-DUMP 1" f)
  (foreach it (vl-sort (bht:pt-all) '(lambda (a b) (< (car a) (car b))))
    (setq p (cdr it) xyz (bht:pv p 'xyz))
    (write-line (strcat "P|" (bht:pv p 'id) "|" (bht:pv p 'ds) "|" (bht:pv p 'row) "|" (bht:pv p 'name) "|" (bht:pv p 'n) "|" (bht:pv p 'e)
                        "|" (bht:pv p 'z) "|" (bht:pv p 'cls) "|" (bht:pv p 'src) "|" (bht:pv p 'time) "|" (bht:pv p 'desc)
                        "|" (bht:fnum (car xyz) 4) "|" (bht:fnum (cadr xyz) 4) "|" (bht:fnum (caddr xyz) 4)) f))
  (foreach sub '("OBJ" "PHOTO" "DATASET" "META" "ROUTE" "SEG")
    (foreach k (bht:rec-keys sub)
      (write-line (strcat "R|" sub "|" k) f)
      (foreach pr (bht:rec-read sub k) (write-line (strcat "  " (car pr) "=" (cdr pr)) f))))
  (foreach k (bht:rec-keys "PHOTO")
    (write-line (strcat "J|" k "|" (bht:str (bht:photo-path (bht:photo-read k)))) f))
  (close f))
(defun t-lines (path / f l out)
  (setq out nil)
  (if (setq f (open path "r" "utf8"))
    (progn (while (setq l (read-line f)) (setq out (cons l out))) (close f)))
  (setq out (reverse out))
  (if (and out (> (strlen (car out)) 0) (= (ascii (substr (car out) 1 1)) 65279)) (setq out (cons (substr (car out) 2) (cdr out))))
  out)
;; So sanh 2 tep tung dong: (giong? so_dong_A so_dong_B dong_khac_dau_tien)
(defun t-cmp (a b / la lb i d)
  (setq la (t-lines a) lb (t-lines b) i 0 d nil)
  (while (and (null d) la lb)
    (setq i (1+ i))
    (if (/= (car la) (car lb)) (setq d (list i (car la) (car lb))))
    (setq la (cdr la) lb (cdr lb)))
  (setq la (t-lines a) lb (t-lines b))
  (list (and (null d) (= (length la) (length lb)) (> (length la) 1)) (length la) (length lb) d))
(defun t-count-prefix (path pre / n)
  (setq n 0)
  (foreach l (t-lines path) (if (wcmatch l (strcat pre "*")) (setq n (1+ n))))
  n)
(defun t-backups (/ n)
  (setq n 0)
  (foreach sub '("OBJ" "PHOTO" "META" "DATASET")
    (foreach g (entget (bht:subdict sub)) (if (and (= (car g) 3) (wcmatch (cdr g) "*__BHT_CU")) (setq n (1+ n)))))
  n)
(defun t-state-save (name lst / f)
  (setq f (open (strcat *T-DIR* "run/state_" name ".txt") "w" "utf8"))
  (foreach x lst (write-line x f)) (close f))
(defun t-state-load (name) (t-lines (strcat *T-DIR* "run/state_" name ".txt")))
